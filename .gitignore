# Files Git should never track. Each group explains why.

# Dependencies: installed from package.json with `npm install`, never committed.
node_modules/

# Build output: regenerated by the build command.
dist/
build/
out/
.astro/
.next/

# Secrets: environment variables stay on this computer and on the host.
# Commit a `.env.example` with placeholder values instead.
.env
.env.*
!.env.example

# Hosting tools' local folders.
.netlify/
.vercel/

# Test and tool output.
coverage/
*.log
npm-debug.log*

# Personal editor settings (shared ones in .vscode/ can be added explicitly).
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Personal Claude Code settings.
.claude/settings.local.json

# Operating system clutter.
.DS_Store
Thumbs.db
desktop.ini
